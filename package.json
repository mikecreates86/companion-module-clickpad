{
	"name": "clickpad",
	"version": "1.1.2",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"check:runtime": "node scripts/check-runtime.mjs",
		"format": "prettier -w .",
		"package": "yarn build && companion-module-build --output pkg/clickpad-$npm_package_version",
		"package:verify": "node scripts/verify-package.mjs",
		"release:check": "yarn test && yarn lint && yarn package && yarn package:verify",
		"build": "yarn check:runtime && rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "yarn check:runtime && run lint:raw .",
		"test": "yarn build && node --test tests/*.test.mjs"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mikecreates86/companion-module-clickpad.git"
	},
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "2.0.4"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.1",
		"@types/node": "^22.19.17",
		"eslint": "^9.39.4",
		"prettier": "^3.8.3",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.59.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.17.0"
}
